# App
NEXT_PUBLIC_APP_URL=https://www.oikaro.com
# Google Search Console — paste the content value from the HTML tag verification method
# GOOGLE_SITE_VERIFICATION=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (create prices with: npm run stripe:setup-prices)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_STARTER_PRICE_ID=
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=
NEXT_PUBLIC_STRIPE_STARTER_ANNUAL_PRICE_ID=
NEXT_PUBLIC_STRIPE_PRO_ANNUAL_PRICE_ID=

# Cron — required in production (Vercel sends Authorization: Bearer $CRON_SECRET)
CRON_SECRET=

# Rentcast — property lookup + listing price/sold sync
RENTCAST_API_KEY=

# Mapbox — CMA comps map (https://account.mapbox.com/access-tokens/)
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# MLS RESO Web API — listing photos for CMA (Spark / Bridge-style feeds)
# When set, comps with an MLS number can show real listing photos instead of map thumbnails.
# MLS_RESO_API_BASE_URL=https://replication.sparkapi.com/Version/3/Reso/OData
# MLS_RESO_ACCESS_TOKEN=
# MLS_RESO_MLS_NUMBER_FIELD=ListingId

# Email (lead follow-up sequences + contact form)
RESEND_API_KEY=
# Verified sender in Resend (default: Oikaro <noreply@oikaro.com>)
# RESEND_FROM=Oikaro <noreply@oikaro.com>
# Optional override for contact form destination (default: support@oikaro.com)
# SUPPORT_EMAIL=

# Optional: SMS when enabled in agent settings
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
